{
  "name": "@verbaloop/server",
  "version": "1.0.0",
  "description": "Backend real-time server for VerbaLoop",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --max-old-space-size=4096 ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@verbaloop/shared": "*",
    "cors": "^2.8.5",
