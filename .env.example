# ==============================================================================
# VerbaLoop: Environment Configuration
# Tagline: Different languages. One conversation.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Optional)
# If MongoDB is unavailable, VerbaLoop automatically defaults to a resilient
# in-memory repository for instant local evaluation without external dependencies.
MONGODB_URI=mongodb://127.0.0.1:27017/verbaloop

# AI Translation Providers (Optional)
# VerbaLoop is architected to be provider-independent.
# If no API key is provided, the platform automatically utilizes the free MyMemory
# translation API combined with an intelligent local conversational debate engine.
#
# Supported Providers:
# 1. Google Gemini (Recommended for nuanced emotional tone and high speed)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Provider Selection: 'gemini' | 'openai' | 'mymemory' | 'fallback'
TRANSLATION_PROVIDER=mymemory

# Client-Side Configuration (Vite)
# Point frontend to your backend deployment URL in production (e.g., https://api.yourdomain.com)
VITE_BACKEND_URL=http://localhost:5000
